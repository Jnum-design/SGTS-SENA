# Copia este archivo como .env y completa los valores. Nunca subas .env a GitHub.
# Usa la URL de conexión de Neon e incluye ?sslmode=require. No compartas esta URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
SECRET_KEY=reemplaza_esto_por_un_valor_largo_y_aleatorio
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# En desarrollo el código de recuperación se imprime en consola y se devuelve en la respuesta.
DEV_SHOW_RECOVERY_CODE=true
